rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function verified(){return request.auth!=null && request.auth.token.email_verified==true;}
  function role(){return request.auth.token.role;}
  function superAdmin(){return verified() && (role()=='superadmin' || request.auth.token.admin==true);}
  function hasRole(r){return verified() && (superAdmin() || role()==r);}
  function canSeeStats(){return hasRole('superadmin') || hasRole('editor') || hasRole('archivist') || hasRole('viewer');}
  match /issues/{id} {
   allow read: if true;
   allow create: if hasRole('archivist') && request.resource.data.number is string && request.resource.data.date is string && request.resource.data.pdfUrl is string && request.resource.data.pdfKey is string;
   allow update,delete: if hasRole('archivist');
  }
  match /siteSettings/{settingId} {
   allow read: if true;
   allow create,update,delete: if superAdmin();
  }
  match /historyImages/{imageId} {
   allow read: if true;
   allow create,update,delete: if hasRole('archivist');
  }
  match /articles/{articleId} {
   allow read: if true;
   allow create,update,delete: if hasRole('editor');
  }
  match /issueViews/{viewId} {
   allow create: if request.resource.data.keys().hasOnly(['issueId','issueNumber','day','visitorId','viewedAt'])
    && request.resource.data.issueId is string
    && request.resource.data.issueNumber is string
    && request.resource.data.day is string
    && request.resource.data.visitorId is string
    && request.resource.data.viewedAt is timestamp
    && viewId == request.resource.data.issueId + '_' + request.resource.data.day + '_' + request.resource.data.visitorId;
   allow read: if canSeeStats();
   allow update,delete: if false;
  }
 }
}